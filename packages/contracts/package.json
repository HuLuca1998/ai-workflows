{
  "name": "@aiwf/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "冻结的契约：Core API、RunEvent 类型清单、节点定义 Schema。UI / 引擎 / MCP 三方共用的唯一真源。",
  "exports": {
    ".": "./src/index.ts",
    "./events": "./src/events.ts",
    "./nodes": "./src/nodes/index.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen": "tsx scripts/generate.ts",
    "gen:check": "tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
