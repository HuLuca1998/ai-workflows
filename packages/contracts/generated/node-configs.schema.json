      },
      "severities": {
        "default": [
          "blocker",
          "major",
          "minor"
        ],
        "description": "严重度分级",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "blocker",
            "major",
            "minor"
          ]
        }
      }
    },
    "required": [
