      },
      "outputParse": {
        "default": "none",
        "description": "输出解析",
        "type": "string",
        "enum": [
          "none",
          "json",
          "lines"
        ]
      },
      "successExitCodes": {
        "default": [
          0
        ],
        "description": "成功退出码",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "outputLimitBytes": {
        "default": 1048576,
        "description": "输出上限（字节）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "timeoutMs": {
        "default": 900000,
        "description": "超时（毫秒）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "interpreter",
      "script"
    ]
  },
  "git.worktree": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "repoRoot": {
        "type": "string",
        "minLength": 1,
        "description": "仓库根目录"
      },
      "baseBranch": {
        "type": "string",
        "minLength": 1,
        "description": "基础分支"
      },
      "branchTemplate": {
        "default": "aiwf/${run.id}",
        "description": "分支命名模板",
        "type": "string",
        "minLength": 1
      },
      "parentDir": {
        "default": "~/worktrees",
        "description": "父目录",
        "type": "string",
        "minLength": 1
      },
      "fetch": {
        "default": true,
        "description": "创建前 fetch",
        "type": "boolean"
      },
      "conflictPolicy": {
        "default": "suffix",
        "description": "冲突策略",
        "type": "string",
        "enum": [
          "fail",
          "reuse",
          "suffix"
        ]
      },
      "cleanupPolicy": {
        "default": "on_success",
        "description": "清理策略",
        "type": "string",
        "enum": [
          "keep",
          "on_success",
          "on_run_end",
          "manual"
        ]
      }
    },
    "required": [
      "repoRoot",
      "baseBranch"
    ]
  },
  "env": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "operations": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "set",
                "unset",
                "read"
              ]
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            },
            "scope": {
              "default": "run",
              "type": "string",
              "enum": [
                "node",
                "run",
                "workflow",
                "global"
              ]
            }
          },
          "required": [
            "op",
            "key"
          ]
        },
        "description": "变量操作"
      },
      "exportDotenv": {
        "default": false,
        "description": "导出 .env",
        "type": "boolean"
      }
    },
    "required": [
      "operations"
    ]
  },
  "mcp.tool": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "serverId": {
        "type": "string",
        "minLength": 1,
        "description": "MCP Server"
      },
      "toolAllowlist": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "工具白名单"
      },
      "args": {
        "default": {},
        "description": "调用参数",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      },
      "scopes": {
        "default": [],
        "description": "权限 Scope",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "serverId",
      "toolAllowlist"
    ]
  }
