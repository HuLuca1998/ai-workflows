{
  "ai.analyze": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "agentProfileId": {
        "type": "string",
        "minLength": 1,
        "description": "Agent 角色\n节点引用角色而不是复制 Prompt；角色升级后引用它的节点一并生效"
      },
      "instruction": {
        "type": "string",
        "minLength": 1,
        "long": true,
        "description": "任务指令"
      },
      "promptId": {
        "description": "提示词\n留空则用该节点类型的内建提示词",
        "type": "string",
        "minLength": 1
      },
      "modelPolicy": {
        "description": "模型策略\n只能选「模型」页里已启用的条目；降级会写入 RunEvent，不静默替换",
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "fast",
              "balanced",
              "quality"
            ]
          },
          {
            "type": "object",
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "modelId"
            ]
          }
        ]
      },
      "turnLimit": {
        "default": 12,
        "description": "Turn 上限",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "outputContract": {
        "description": "输出契约",
        "type": "object",
        "properties": {
          "documents": {
            "default": "multi",
            "description": "产出文档数量",
            "type": "string",
            "enum": [
              "single",
              "multi"
            ]
          },
          "summarySchema": {
            "description": "结构化摘要 Schema\n要求 JSON 输出的节点只能选带「结构化输出」能力的模型",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        }
      },
      "target": {
        "type": "string",
        "minLength": 1,
        "description": "分析对象"
      }
    },
    "required": [
      "agentProfileId",
      "instruction",
      "target"
    ]
  },
