  "entry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "trigger": {
        "default": "manual",
        "description": "触发方式",
        "type": "string",
        "enum": [
          "manual",
          "shortcut",
          "url_scheme",
          "schedule",
          "webhook"
        ]
      },
      "workdirSource": {
        "default": "prompt",
        "description": "工作目录来源",
        "type": "string",
        "enum": [
          "prompt",
          "fixed",
          "inherit"
        ]
      },
      "workdir": {
        "description": "固定工作目录\n仅当来源选 fixed 时生效",
        "type": "string"
      },
      "inputSchema": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {},
        "description": "输入参数 Schema\n启动表单按它自动生成"
      },
      "injectedFields": {
        "default": [],
        "description": "系统注入字段",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "inputSchema"
    ]
  },
  "subworkflow": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "workflowId": {
        "type": "string",
        "minLength": 1,
        "description": "目标工作流"
      },
      "versionRef": {
        "type": "string",
        "minLength": 1,
        "description": "运行版本\nlatest 或具体版本号"
      },
      "mode": {
        "default": "sync",
        "description": "调用方式",
        "type": "string",
        "enum": [
          "sync",
          "parallel"
        ]
      },
      "inputMapping": {
        "default": {},
        "description": "输入映射",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "outputMapping": {
        "default": {},
        "description": "输出映射",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "concurrencyLimit": {
        "default": 1,
        "description": "并发上限",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "onFailure": {
        "default": "fail_parent",
        "description": "失败策略",
        "type": "string",
        "enum": [
          "fail_parent",
          "continue",
          "retry"
        ]
      },
      "approvalInheritance": {
        "default": "inherit",
        "description": "审批继承\ninherit 时子运行的审批冒泡到父运行",
        "type": "string",
        "enum": [
          "inherit",
          "isolate"
        ]
      }
    },
    "required": [
      "workflowId",
      "versionRef"
    ]
  },
  "branch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "cases": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "port": {
              "type": "string",
              "minLength": 1
            },
            "when": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "port",
            "when"
          ]
        },
        "description": "分支条件\n每条对应一个输出端口"
      },
      "defaultPort": {
        "default": "default",
        "description": "兜底端口",
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "cases"
    ]
  },
  "transform": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "mappings": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "from",
            "to"
          ]
        },
        "description": "字段映射\nfrom 用 JSONPath 取值"
      },
      "outputSchema": {
        "description": "输出 Schema",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    },
    "required": [
      "mappings"
    ]
  },
  "end": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "outcome": {
        "type": "string",
        "enum": [
          "success",
          "failure"
        ],
        "description": "运行结果"
      },
      "artifacts": {
        "default": [],
        "description": "最终产物",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "required": [
      "outcome"
    ]
  },
  "approval": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "审批标题"
      },
      "bodyMarkdown": {
        "default": "",
        "long": true,
        "description": "审批内容\n支持 Markdown",
        "type": "string"
      },
      "interaction": {
        "type": "string",
        "enum": [
          "single",
          "multi",
          "confirm",
          "supplement"
        ],
        "description": "交互类型"
      },
      "options": {
        "default": [],
        "description": "可选项",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "recommended": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "label"
          ]
        }
      },
      "waitStrategy": {
        "default": "forever",
        "description": "等待策略",
        "type": "string",
        "enum": [
          "forever",
          "timeout"
        ]
      },
      "timeoutMs": {
        "description": "等待超时（毫秒）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "reminderAfterMs": {
        "description": "提醒间隔（毫秒）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "title",
      "interaction"
    ]
  },
  "notify": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "description": "通知标题"
      },
      "subtitle": {
        "description": "副标题",
        "type": "string"
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "long": true,
        "description": "通知正文"
      },
      "on": {
        "default": [
          "completed",
          "failed",
          "waiting_approval"
        ],
        "description": "触发条件",
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "completed",
            "failed",
            "waiting_approval",
            "cancelled"
          ]
        }
      },
      "clickAction": {
        "default": "open_run",
        "description": "点击动作",
        "type": "string",
        "enum": [
          "open_run",
          "open_workflow",
          "none"
        ]
      },
      "onFailure": {
        "default": "ignore",
        "description": "失败处理",
        "type": "string",
        "enum": [
          "ignore",
          "fail_node",
          "retry"
        ]
      }
    },
    "required": [
      "title",
      "body"
    ]
  },
  "script.shell": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "interpreter": {
        "type": "string",
        "enum": [
          "zsh",
          "bash",
          "sh"
        ],
        "description": "解释器\n白名单：任意可执行文件会绕过命令能力声明"
      },
      "script": {
        "type": "string",
