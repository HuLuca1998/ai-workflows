        "long": true,
        "description": "脚本内容\n${…} 的值会自动加引号，脚本里不要再套一层"
      },
      "workdir": {
        "description": "工作目录",
        "type": "string"
      },
      "env": {
        "default": {},
        "description": "环境变量",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "secretEnv": {
        "default": {},
        "description": "凭据环境变量\n用 keychain:// 引用，明文永不入库",
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string"
        }
      },
      "outputParse": {
        "default": "none",
        "description": "输出解析",
        "type": "string",
        "enum": [
          "none",
          "json",
          "lines"
        ]
      },
      "successExitCodes": {
        "default": [
          0
        ],
        "description": "成功退出码",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "outputLimitBytes": {
        "default": 1048576,
        "description": "输出上限（字节）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "timeoutMs": {
        "default": 900000,
        "description": "超时（毫秒）",
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "required": [
      "interpreter",
      "script"
    ]
  },
