{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Workflows",
  "identifier": "com.huluca.aiworkflows",
  "version": "0.0.0",
  "build": {
    "beforeDevCommand": "pnpm --filter @aiwf/web dev",
    "beforeBuildCommand": "pnpm --filter @aiwf/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Workflows",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "resizable": true,
        "decorations": true,
        "minimizable": true,
        "maximizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "MIT",
    "category": "DeveloperTool",
    "shortDescription": "本地优先的 AI Workflow 客户端",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1NEY5MDU4OEE3QTA5ODEKUldTQkNYcUtXSkJQUlp1eTVuODJtR1hwMUMxZnk2REJsNHpDeEhmVEx5Nm9OM2h3eGp5TjFGOGIK",
      "endpoints": [
        "https://github.com/HuLuca1998/ai-workflows/releases/latest/download/latest.json"
      ]
    }
  }
}
